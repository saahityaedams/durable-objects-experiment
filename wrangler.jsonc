/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "durable-objects-experiment",
	"compatibility_date": "2026-08-25",
	"main": "./workers/app.ts",
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
		"ADMISSION_TOKEN_SECRET": "dev-only-change-me-in-production"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Durable Objects
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{ "name": "SEAT_SHARD", "class_name": "SeatShard" },
			{ "name": "QUEUE_ROOM", "class_name": "QueueRoom" },
			{ "name": "USER_HOLD", "class_name": "UserHold" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SeatShard", "QueueRoom", "UserHold"]
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
}
