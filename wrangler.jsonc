/**
 * Wrangler configuration: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "concert-booking",
	"compatibility_date": "2026-08-25",
	"main": "./workers/app.ts",
	/**
	 * Secrets: set locally in .dev.vars (see .dev.vars.example) and in
	 * production with `wrangler secret put ADMISSION_TOKEN_SECRET`.
	 */
	"secrets": {
		"required": ["ADMISSION_TOKEN_SECRET"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Durable Objects: https://developers.cloudflare.com/durable-objects/
	 * - QueueRoom: one per event; the waiting room, lottery and admission ticks.
	 * - SeatShard: one per (event, section); seat inventory and atomic holds.
	 * - UserHold:  one per (event, fan); the per-fan hold limit across shards.
	 */
	"durable_objects": {
		"bindings": [
			{ "name": "SEAT_SHARD", "class_name": "SeatShard" },
			{ "name": "QUEUE_ROOM", "class_name": "QueueRoom" },
			{ "name": "USER_HOLD", "class_name": "UserHold" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SeatShard", "QueueRoom", "UserHold"]
		}
	]
}
